{
  "name": "aegis-webshield-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Aegis WebShield AI desktop security scanning app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app-smoke:record": "node scripts/record-app-smoke-result.mjs",
    "verify:app-smoke": "node scripts/verify-app-smoke-result.mjs",
    "verify:brand-icons": "node scripts/verify-brand-icons.mjs",
    "verify:tauri-security": "node scripts/verify-tauri-security-config.mjs",
    "bootstrap:windows-rust": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-windows-rust.ps1",
    "release:machine-check": "powershell -ExecutionPolicy Bypass -File scripts/check-windows-release-machine.ps1",
    "release:windows-candidate": "powershell -ExecutionPolicy Bypass -File scripts/run-windows-release-candidate.ps1",
    "rc:security-performance": "node scripts/run-rc-security-performance.mjs",
    "rc:functional-e2e": "node scripts/run-rc-functional-e2e.mjs",
    "verify:rc-security-performance": "node scripts/verify-rc-security-performance.mjs",
    "verify:rc-functional-e2e": "node scripts/run-rc-functional-e2e.mjs --verify",
    "verify:windows": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows-native.ps1",
    "verify:windows-signatures": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows-signatures.ps1",
    "sign:windows-installers": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows-installers.ps1",
    "bundle:windows": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows-native.ps1 -Bundle",
    "smoke:windows-installer": "powershell -ExecutionPolicy Bypass -File scripts/smoke-windows-installer.ps1",
    "update:prepare-manifest": "node scripts/prepare-update-manifest.mjs",
    "browser:crawl": "node scripts/browser-crawl-worker.mjs",
    "release:audit": "node scripts/audit-release-candidate.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:tag-readiness": "node scripts/verify-release-tag-readiness.mjs",
    "smartscreen:prepare": "node scripts/prepare-smartscreen-submission.mjs",
    "smartscreen:verify-tracker": "node scripts/verify-smartscreen-tracker.mjs",
    "support:verify-diagnostics": "node scripts/verify-support-diagnostics.mjs",
    "update:verify-manifest": "node scripts/verify-update-manifest.mjs",
    "public:prepare": "node scripts/prepare-public-source.mjs",
    "test:publication": "node --test tests/publication.test.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "test:community-ui": "node scripts/test-community-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1"
  },
  "license": "Apache-2.0"
}
